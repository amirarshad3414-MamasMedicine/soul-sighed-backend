# --- database ---
DATABASE_URL=postgresql+asyncpg://app:app_password@localhost:5433/app_db

# --- auth ---
JWT_SECRET=            # 32+ bytes; generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440   # 24h, matching Xano's expiration = 86400

# --- Xano (migration tooling only; not used at runtime) ---
XANO_PAT=
XANO_META_BASE=https://xnrw-fohw-scw8.a2.xano.io/api:meta
XANO_API_BASE=https://xnrw-fohw-scw8.a2.xano.io/api:uUEiFEze
XANO_WORKSPACE_ID=1
XANO_APIGROUP_ID=4

# --- external services ported from Xano stacks ---
GOOGLE_GEOCODING_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
INSIGHTS_API_KEY=
INSIGHTS_WEBHOOK_SECRET=
KLAVIYO_API_KEY=          # currently hardcoded in the Xano checkout stack
STRIPE_KEY=

# --- email (transactional provider, NOT personal gmail) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
